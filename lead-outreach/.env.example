# Copy this file to .env and fill in your own values. Never commit .env.
# Leave EMAIL_PROVIDER and WHATSAPP_PROVIDER as "mock" until you have tested everything.

# ---------- App ----------
HOST=127.0.0.1                 # keep 127.0.0.1 unless you need remote access
PORT=3100
DEFAULT_COUNTRY=NG             # used for numbers without a country code (NG, GB, US... or +234)
DATA_DIR=data                  # jobs and the suppression list live here (git-ignored)
ADMIN_TOKEN=                   # REQUIRED before exposing the app to the internet: dashboard password

# Public URL of this app (for one-click unsubscribe links and WhatsApp webhooks), e.g. an ngrok URL.
PUBLIC_BASE_URL=
UNSUBSCRIBE_SECRET=            # any long random string; signs unsubscribe links

# ---------- Sender identity ----------
EMAIL_FROM=you@yourdomain.com
EMAIL_FROM_NAME=Your Name
EMAIL_REPLY_TO=
SENDER_POSTAL_ADDRESS=         # CAN-SPAM needs a physical mailing address in commercial email

# ---------- Email provider: smtp | resend | sendgrid | mock ----------
EMAIL_PROVIDER=mock

# SMTP (Gmail/Google Workspace app password, Zoho, Brevo, Mailgun SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false              # true for port 465
SMTP_USER=
SMTP_PASS=

# Resend (https://resend.com) or SendGrid (https://sendgrid.com)
RESEND_API_KEY=
SENDGRID_API_KEY=

# Email throttling: random delay between sends, plus an hourly cap
EMAIL_MIN_DELAY_MS=5000
EMAIL_MAX_DELAY_MS=15000
EMAIL_MAX_PER_HOUR=200

# ---------- WhatsApp provider: cloud | mock ----------
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=         # permanent System User token from Meta Business Settings
WHATSAPP_PHONE_NUMBER_ID=      # from WhatsApp > API Setup
WHATSAPP_BUSINESS_ACCOUNT_ID=  # WABA id, lets the app check template status
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN= # any string; paste the same value in Meta's webhook settings
WHATSAPP_APP_SECRET=           # App Dashboard > Settings > Basic; used to verify webhook signatures

# WhatsApp throttling
WHATSAPP_MIN_DELAY_MS=8000
WHATSAPP_MAX_DELAY_MS=20000
WHATSAPP_MAX_PER_HOUR=100

# ---------- Retries ----------
MAX_SEND_ATTEMPTS=3
RETRY_BASE_DELAY_MS=2000

# ---------- Optional AI variation (Claude) ----------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---------- Defaults for the test-send form ----------
TEST_EMAIL=
TEST_WHATSAPP_NUMBER=
